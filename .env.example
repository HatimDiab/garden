# Copy to .env and fill in:  cp .env.example .env

# --- Admin login (seeded on first start) ---------------------------------
ADMIN_USERNAME=gardener
ADMIN_PASSWORD=                       # REQUIRED — pick a strong password

# ADMIN_PASSWORD only bootstraps the account. Once the admin user exists, a
# password changed in the admin UI wins and restarts leave it alone. Set this to
# 1 for a single boot to force the password back to ADMIN_PASSWORD (this also
# signs out every session), then unset it again.
# ADMIN_PASSWORD_FORCE_RESET=1

# --- Site identity -------------------------------------------------------
SITE_TITLE=The Garden Diary
SITE_TAGLINE=Pages from our garden, petal by petal.

# --- Local / single-container (make start) -------------------------------
PORT=3000                             # host port for the plain HTTP container
BIND_ADDR=0.0.0.0                     # 127.0.0.1 to keep admin off the LAN

# The container runs as this uid:gid so it can write ./data. Must match whoever
# owns that directory on the host — check with `id -u` and `id -g`. 1000:1000 is
# the first login user on Debian/Ubuntu/Raspberry Pi OS.
PUID=1000
PGID=1000

# --- Public HTTPS deploy (make start-production + Traefik) ----------------
GARDEN_HOST=garden.example.com        # your domain; A record must point here
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices
