# Copy to .env and fill in:  cp .env.example .env

# --- Admin login (seeded on first start) ---------------------------------
ADMIN_USERNAME=gardener
ADMIN_PASSWORD=                       # REQUIRED — pick a strong password

# --- Site identity -------------------------------------------------------
SITE_TITLE=The Garden Diary
SITE_TAGLINE=Pages from our garden, petal by petal.

# --- Local / single-container (make start) -------------------------------
PORT=3000                             # host port for the plain HTTP container

# --- Public HTTPS deploy (make start-production + Traefik) ----------------
GARDEN_HOST=garden.example.com        # your domain; A record must point here
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices
