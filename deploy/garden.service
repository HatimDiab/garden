# The Garden Diary — systemd USER unit (rootless Docker)
#
# Install to ~/.config/systemd/user/garden.service for the `karl` account.
# See "Rootless Docker: karl owns everything" in DEPLOY.md.
#
# This is a --user unit: it is owned and run by karl, talking to karl's own
# rootless dockerd. Nothing here runs as root, and karl is NOT in the `docker`
# group — that group is root-equivalent on the host, so joining it would undo
# the point of this setup.
#
# `--remove-orphans` is deliberately absent: the Traefik stack shares this
# directory, and with the default project name compose would treat its
# containers as orphans of this project and remove them.

[Unit]
Description=The Garden Diary
Documentation=https://github.com/HatimDiab/garden
Requires=docker.service traefik.service
After=docker.service traefik.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/garden

# %t is XDG_RUNTIME_DIR (/run/user/<uid>) — karl's rootless socket, not the
# system one at /var/run/docker.sock.
Environment=DOCKER_HOST=unix://%t/docker.sock

ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml up -d --build

# Image builds on a Pi are slow; do not let systemd time them out.
TimeoutStartSec=0

[Install]
WantedBy=default.target
