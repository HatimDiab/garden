# The Garden Diary — systemd unit (public HTTPS / production)
#
# Starts the app behind Traefik at boot and gives you systemctl control.
# Install: see "Running as a service user with auto-start" in DEPLOY.md
#
# This unit runs as root because it talks to the Docker daemon. The APP does
# not: docker-compose.yml sets `user: "${PUID}:${PGID}"`, so the container runs
# as the unprivileged account that owns the files (karl:www in the guide).
#
# Do NOT "fix" that by running this unit as karl and adding karl to the `docker`
# group. Membership in `docker` is equivalent to root on the host — a member can
# start a container that bind-mounts / — so it would grant full privileges while
# looking like a hardening step.
#
# `--remove-orphans` is deliberately absent: the Traefik stack shares this
# directory, and with the default project name compose would treat its
# containers as orphans of this project and remove them.

[Unit]
Description=The Garden Diary
Documentation=https://github.com/HatimDiab/garden
Requires=docker.service traefik.service
After=docker.service traefik.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/garden

ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.production.yml up -d --build

# Image builds on a Pi are slow; do not let systemd time them out.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
