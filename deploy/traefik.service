# Traefik reverse proxy — systemd USER unit (rootless Docker)
#
# Install to ~/.config/systemd/user/traefik.service for the `karl` account.
# See "Rootless Docker: karl owns everything" in DEPLOY.md.
#
# Binding :80 and :443 from a rootless daemon requires
# net.ipv4.ip_unprivileged_port_start=80 on the host; DEPLOY.md sets it.
#
# NOTE the `-p traefik`. Both compose stacks live in the same directory, so they
# would otherwise share the default project name ("garden") and each would treat
# the other's containers as orphans.

[Unit]
Description=Traefik reverse proxy for The Garden Diary
Documentation=https://github.com/HatimDiab/garden
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/garden

Environment=DOCKER_HOST=unix://%t/docker.sock

# The `web` network is external and shared; create it if this is a cold boot.
ExecStartPre=/bin/sh -c 'docker network inspect web >/dev/null 2>&1 || docker network create web'
ExecStart=/usr/bin/docker compose -p traefik -f docker-compose.traefik.yml up -d
ExecStop=/usr/bin/docker compose -p traefik -f docker-compose.traefik.yml down

TimeoutStartSec=0

[Install]
WantedBy=default.target
